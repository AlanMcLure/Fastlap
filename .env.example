DATABASE_URL=
NEXTAUTH_SECRET=
# Auth.js v5 on self-hosted deployments (Docker); not needed on Vercel
AUTH_URL=
AUTH_TRUST_HOST=true

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

UPLOADTHING_SECRET=
UPLOADTHING_APP_ID=

REDIS_URL=
REDIS_SECRET=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional: F1 data API base URL (defaults to Jolpica, the Ergast successor)
# ERGAST_BASE_URL=https://api.jolpi.ca/ergast/f1
# Secret for /api/f1/sync (backfills the own copy of finished seasons); the route is off without it
# CRON_SECRET=

# Premium (Stripe) is hidden until the project is published. Set to true at build time to enable it.
NEXT_PUBLIC_PREMIUM_ENABLED=false
