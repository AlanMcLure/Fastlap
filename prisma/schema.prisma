// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VoteType {
  UP
  DOWN
}

enum UserRole {
  USER
  ADMIN
  PREMIUM
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id                String         @id @default(cuid())
  name              String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  email             String?        @unique
  emailVerified     DateTime?
  role              UserRole       @default(USER)
  /// Declaration of age (>= 14) and acceptance of the terms made when the account was created.
  termsAcceptedAt   DateTime?
  termsVersion      String?
  createdSubreddits Subreddit[]    @relation("CreatedBy")
  subscriptions     Subscription[]
  votes             Vote[]

  username String? @unique

  image         String?
  accounts      Account[]
  sessions      Session[]
  Post          Post[]
  Comment       Comment[]
  CommentVote   CommentVote[]
  dotdVotes     DriverOfDayVote[]
  predictions   Prediction[]
  notifications Notification[]
  reportsMade   Report[]
}

model Subreddit {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  posts     Post[]

  creatorId   String?
  Creator     User?              @relation("CreatedBy", fields: [creatorId], references: [id])
  subscribers Subscription[]
  leagues     PredictionLeague[]

  @@index([name])
  @@index([creatorId])
}

model Subscription {
  user        User      @relation(fields: [userId], references: [id])
  userId      String
  subreddit   Subreddit @relation(fields: [subredditId], references: [id])
  subredditId String

  @@id([userId, subredditId])
}

model Post {
  id          String       @id @default(cuid())
  title       String
  content     Json?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  author      User         @relation(fields: [authorId], references: [id])
  authorId    String
  subreddit   Subreddit    @relation(fields: [subredditId], references: [id])
  subredditId String
  comments    Comment[]
  votes       Vote[]
  raceWeekend RaceWeekend?
  reports     Report[]

  @@index([authorId])
  @@index([subredditId])
}

model Comment {
  id        String   @id @default(cuid())
  text      String
  createdAt DateTime @default(now())
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String

  replyToId String?
  replyTo   Comment?  @relation("ReplyTo", fields: [replyToId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  replies   Comment[] @relation("ReplyTo")

  votes     CommentVote[]
  reports   Report[]
  commentId String?

  @@index([authorId])
  @@index([postId])
  @@index([replyToId])
}

model Vote {
  user   User     @relation(fields: [userId], references: [id])
  userId String
  post   Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId String
  type   VoteType

  @@id([userId, postId])
}

model CommentVote {
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  commentId String
  type      VoteType

  @@id([userId, commentId])
}

/// Own copy of finished Jolpica-F1 data (see src/lib/f1/snapshots.ts). Only data
/// that can no longer change is stored; `key` encodes the query and a schema version.
model F1Snapshot {
  key       String   @id
  payload   Json
  updatedAt DateTime @updatedAt
}

/// Automatic discussion thread of a race weekend (see src/lib/raceThread.ts).
/// The thread is an ordinary Post, so comments and votes work as everywhere else.
model RaceWeekend {
  id        String   @id @default(cuid())
  season    Int
  round     Int
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String   @unique
  createdAt DateTime @default(now())

  @@unique([season, round])
}

/// One "Driver of the Day" vote per user and race; changing it overwrites the row.
model DriverOfDayVote {
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  season    Int
  round     Int
  driverId  String
  createdAt DateTime @default(now())

  @@id([userId, season, round])
  @@index([season, round])
}

enum PredictionKind {
  RACE
  SPRINT
}

/// Prediction league of a community for one season (see src/lib/league.ts).
/// Points are not stored: they are computed from the official results on read.
model PredictionLeague {
  id               String       @id @default(cuid())
  subreddit        Subreddit    @relation(fields: [subredditId], references: [id], onDelete: Cascade)
  subredditId      String
  season           Int
  /// Points for each podium position guessed exactly.
  exactPoints      Int          @default(5)
  /// Points for a driver who finishes on the podium but in another place.
  presentPoints    Int          @default(2)
  fastestLapPoints Int          @default(3)
  sprintEnabled    Boolean      @default(true)
  createdAt        DateTime     @default(now())
  predictions      Prediction[]

  @@unique([subredditId, season])
}

/// Podium (and, for races, fastest lap) guess of one user for one race or sprint.
model Prediction {
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  league     PredictionLeague @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  leagueId   String
  round      Int
  kind       PredictionKind
  p1         String
  p2         String
  p3         String
  fastestLap String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@id([userId, leagueId, round, kind])
  @@index([leagueId, round])
}

enum NotificationType {
  POST_COMMENT
  MOD_REMOVED
  COMMENT_REPLY
  PREDICTION_CLOSING
  PREDICTION_SCORED
}

/// In-app notification (see src/lib/notifications.ts). `dedupeKey` makes generated
/// ones (reminders, scores) idempotent: the same event never notifies a user twice.
model Notification {
  id        String           @id @default(cuid())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  type      NotificationType
  body      String
  href      String
  dedupeKey String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt])
}

enum ReportReason {
  SPAM
  ABUSE
  OFF_TOPIC
  OTHER
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

/// A user's report of a post or a comment (see src/lib/moderation.ts). `targetKey`
/// ("post:<id>" / "comment:<id>") makes one report per user and target. Reports go away
/// with the content (cascade); what moderators did is kept in ModerationLog.
model Report {
  id         String       @id @default(cuid())
  reporter   User         @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reporterId String
  targetKey  String
  post       Post?        @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId     String?
  comment    Comment?     @relation(fields: [commentId], references: [id], onDelete: Cascade)
  commentId  String?
  reason     ReportReason
  details    String?
  status     ReportStatus @default(OPEN)
  resolvedAt DateTime?
  createdAt  DateTime     @default(now())

  @@unique([reporterId, targetKey])
  @@index([status, createdAt])
  @@index([targetKey])
}

/// What moderators decided, kept after the reported content is gone.
model ModerationLog {
  id          String   @id @default(cuid())
  moderatorId String
  /// REMOVE_POST | REMOVE_COMMENT | DISMISS
  action      String
  targetKey   String
  /// Start of the content or title, for the log.
  excerpt     String
  authorId    String?
  reportCount Int
  createdAt   DateTime @default(now())

  @@index([createdAt])
}
